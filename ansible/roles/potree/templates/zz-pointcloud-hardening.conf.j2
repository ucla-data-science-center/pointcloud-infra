# {{ ansible_managed }}
# Loaded last in conf.d (zz-*) so these settings win.
ServerTokens Prod
ServerSignature Off
TraceEnable Off

Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# No X-Frame-Options: collection pages may be embedded in other sites; leave framing allowed.
