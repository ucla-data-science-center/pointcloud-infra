# {{ ansible_managed }}
# Source: pointcloud-infra/ansible/roles/potree/templates/pointcloud.conf.j2

<VirtualHost *:80>
    ServerName {{ potree_server_name }}
{% for alias in potree_server_aliases %}
    ServerAlias {{ alias }}
{% endfor %}

    # Let's Encrypt HTTP-01 challenges are answered here; everything else
    # redirects to HTTPS on the canonical name.
    Alias /.well-known/acme-challenge/ {{ potree_letsencrypt_webroot }}/.well-known/acme-challenge/
    <Directory {{ potree_letsencrypt_webroot }}/.well-known/acme-challenge>
        Require all granted
    </Directory>

    RewriteEngine on
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://{{ potree_server_name }}%{REQUEST_URI} [R=301,L]

    ErrorLog logs/pointcloud-error.log
    CustomLog logs/pointcloud-access.log combined
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ potree_server_name }}
{% for alias in potree_server_aliases %}
    ServerAlias {{ alias }}
{% endfor %}

    DocumentRoot {{ potree_web_root }}

    Protocols h2 http/1.1
{% if potree_canonical_redirect %}

    # Canonical host. S3 only serves point clouds to pages whose Referer is
    # {{ potree_server_name }}, so aliases must redirect rather than serve.
    RewriteEngine on
    RewriteCond %{HTTP_HOST} !^{{ potree_server_name | regex_escape }}$ [NC]
    RewriteRule ^ https://{{ potree_server_name }}%{REQUEST_URI} [R=301,L]
{% endif %}

    # Potree's JS/CSS (several MB) only changes on a release upgrade.
    # Cache for a day; ETags make revalidation cheap after that.
    <LocationMatch "^/(build|libs|branding)/">
        Header set Cache-Control "public, max-age=86400"
    </LocationMatch>

    SSLEngine on
    SSLCertificateFile {{ _potree_tls_cert }}
    SSLCertificateKeyFile {{ _potree_tls_key }}
    # Protocols and ciphers come from the system crypto policy
    # (update-crypto-policies), the Red Hat way; no per-site overrides.
{% if potree_hsts_max_age | int > 0 %}
    Header always set Strict-Transport-Security "max-age={{ potree_hsts_max_age }}"
{% endif %}

    <Directory {{ potree_web_root }}>
        Options Indexes FollowSymLinks
        AllowOverride None
        Require all granted

        # UCLA Library skin for the mod_autoindex listing.
        # IndexStyleSheet (not a <link> in IndexHeadInsert) is what makes
        # Apache emit table#indexlist and the row classes the CSS targets.
        IndexOptions FancyIndexing HTMLTable SuppressRules NameWidth=* DescriptionWidth=* Charset=UTF-8 IconsAreLinks FoldersFirst IgnoreCase
        IndexStyleSheet /branding/ucla-index.css
        IndexHeadInsert "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
        HeaderName /branding/header.html
        ReadmeName /branding/footer.html
        IndexIgnore {{ potree_autoindex_ignore | join(' ') }}
    </Directory>

    # Description column text, generated from content/descriptions.yml.
    Include /etc/httpd/conf.d/pointcloud-descriptions.inc

    ErrorLog logs/pointcloud-error.log
    CustomLog logs/pointcloud-access.log combined
</VirtualHost>
